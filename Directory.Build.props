<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <WinPilotProductVersion>1.2.0.0</WinPilotProductVersion>
    <WinPilotFileVersion>$(WinPilotProductVersion)</WinPilotFileVersion>
    <Version>$(WinPilotFileVersion)</Version>
    <FileVersion>$(WinPilotFileVersion)</FileVersion>
    <InformationalVersion>$(WinPilotProductVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
