<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <AssemblyName>WinPilot-Updater</AssemblyName>
    <RootNamespace>WinPilotUSB.Updater</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <ApplicationManifest>.work\updater.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.0.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <Company>WeeshiTech Solutions</Company>
    <Product>WinPilot Updater</Product>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include=".work\Updater.cs" />
    <Reference Include="System" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
